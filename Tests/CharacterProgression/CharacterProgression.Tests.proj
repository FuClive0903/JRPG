<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LanguageTargets>$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>../../Temp/CharacterProgressionTests/bin/</BaseOutputPath>
    <UnityEditorPath Condition="'$(UnityEditorPath)' == ''">$(ProgramFiles)\Unity\Hub\Editor\6000.6.0f1\Editor</UnityEditorPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scipts/UI/CharacterExperienceText.cs" />
    <Compile Include="../../Assets/Scipts/UI/MenuInputState.cs" />
    <Compile Include="../../Assets/Scipts/GameFlow/GameRuntimeState.cs" />
    <Compile Include="../../Assets/Scipts/GameFlow/GameSaveSystem.cs" />
    <Compile Include="../../Assets/Scipts/Progression/CharacterProgression.cs" Link="CharacterProgression.cs" />
    <Compile Include="../../Assets/Scipts/Progression/CharacterGrowth.cs" Link="CharacterGrowth.cs" />
    <Compile Include="../../Assets/Scipts/Battle/Combatant.cs" Link="Combatant.cs" />
    <Compile Include="../../Assets/Scipts/Settings/BattleData.cs" Link="BattleData.cs" />
    <Compile Include="../../Assets/Scipts/GameFlow/BattleSession.cs" Link="BattleSession.cs" />
    <Compile Include="../../Assets/Scipts/Battle/BattleRewardResult.cs" Link="BattleRewardResult.cs" />
    <Compile Include="../../Assets/Scipts/Battle/BattleRewardCalculator.cs" Link="BattleRewardCalculator.cs" />
    <Compile Include="../../Assets/Scipts/Battle/BattleState.cs" Link="BattleState.cs" />
    <Compile Include="../../Assets/Scipts/Battle/BattleTurnOrder.cs" Link="BattleTurnOrder.cs" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.JSONSerializeModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ScriptingModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.ScriptingModule.dll</HintPath>
    </Reference>
    <None Include="../../Assets/Resources/Data/BattleData.json" Link="BattleData.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

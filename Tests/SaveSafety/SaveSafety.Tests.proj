<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LanguageTargets>$(MSBuildToolsPath)/Microsoft.CSharp.targets</LanguageTargets>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>../../Temp/SaveSafetyTests/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;../BattlePlayback/UnityDoubles.cs" />
    <Compile Include="../../Assets/Scipts/GameFlow/GameSaveSystem.cs;../../Assets/Scipts/GameFlow/GameRuntimeState.cs;../../Assets/Scipts/GameFlow/BattleSession.cs" />
    <Compile Include="../../Assets/Scipts/Battle/Combatant.cs;../../Assets/Scipts/Battle/BattleRewardResult.cs;../../Assets/Scipts/Battle/BattleState.cs;../../Assets/Scipts/Battle/BattleNumberStyle.cs" />
    <Compile Include="../../Assets/Scipts/Settings/BattleData.cs;../../Assets/Scipts/Progression/CharacterProgression.cs;../../Assets/Scipts/Progression/CharacterGrowth.cs" />
    <None Include="../../Assets/Resources/Data/BattleData.json" Link="BattleData.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
